# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Supabase Cloud (free tier) — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Senha do Postgres (Dashboard → Database) — necessária para supabase link / push / reset no Cloud
# SUPABASE_DB_PASSWORD=your-database-password

# Local Supabase (Docker) — npm run supabase:start && npm run supabase:env
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# LLM — Google Gemini API (Google AI Studio, free tier)
# LLM_PROVIDER=gemini
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# LLM — OpenRouter (https://openrouter.ai/keys)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_CHAT_MODEL=google/gemma-2-9b-it:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# RAG — knowledge base (OpenRouter embeddings + Supabase pgvector)
RAG_ENABLED=true
RAG_CHAT_ENABLED=true
RAG_TOP_K=5
# RAG_CHAT_EMBEDDING_TIMEOUT_MS=8000
# RAG_RETRIEVAL_TIMEOUT_MS=8000
# RAG_EMBEDDING_MAX_RETRIES=3
# RAG_EMBEDDING_CIRCUIT_MS=300000
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_MAX_CHUNKS_PER_DOCUMENT=1500
# RAG_EMBEDDING_BATCH_SIZE=64
# RAG_EMBEDDING_TIMEOUT_MS=120000
# RAG_CHUNK_INSERT_BATCH_SIZE=40
# KNOWLEDGE_UPLOAD_ROLE=psychologist
# KNOWLEDGE_MAX_FILE_BYTES=10485760

# Speech-to-text — AssemblyAI Universal-2 (patient audio messages)
# ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# SPEECH_MAX_FILE_BYTES=5242880

# Seed — platform admin (npm run seed:psychologists)
# SEED_ADMIN_EMAIL=admin@mindbridge.local
# SEED_ADMIN_PASSWORD=Emir#262689

# LLM — Ollama local (optional fallback: LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=gemma4
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
