# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Supabase Cloud (free tier) — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Senha do Postgres (Dashboard → Database) — necessária para supabase link / push / reset no Cloud
# SUPABASE_DB_PASSWORD=your-database-password

# Local Supabase (Docker) — npm run supabase:start && npm run supabase:env
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# LLM — Google Gemini API (Google AI Studio, free tier)
# LLM_PROVIDER=gemini
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# LLM — OpenRouter (https://openrouter.ai/keys)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_CHAT_MODEL=google/gemma-2-9b-it:free

# RAG — knowledge base (OpenRouter embeddings + Supabase pgvector)
# RAG_ENABLED=true
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# KNOWLEDGE_UPLOAD_ROLE=admin
# KNOWLEDGE_MAX_FILE_BYTES=10485760

# LLM — Ollama local (optional fallback: LLM_PROVIDER=ollama)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=gemma4
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
