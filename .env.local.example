# Copie para .env após `npm run supabase:start` e `npm run supabase:env`,
# ou use os valores exibidos por `npx supabase status`.
#
# Chaves abaixo são as defaults do Supabase local (JWT demo).
# Se você regenerou secrets no CLI, rode `npm run supabase:env`.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
