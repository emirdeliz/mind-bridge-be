{
  "name": "mind-bridge-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "bash scripts/supabase-reset.sh",
    "supabase:push:cloud": "bash scripts/supabase-push-cloud.sh",
    "supabase:reset:cloud": "bash scripts/supabase-reset-cloud.sh",
    "seed:cloud": "bash scripts/seed-cloud.sh",
    "supabase:env": "bash scripts/supabase-env.sh",
    "seed:local": "node --env-file=.env scripts/seed-local-dev.mjs",
    "seed:demo-patients": "npm run seed:local",
    "billing:snapshot": "tsx --env-file=.env scripts/run-billing-jobs.ts snapshot",
    "billing:finalize": "tsx --env-file=.env scripts/run-billing-jobs.ts finalize",
    "billing:jobs": "tsx --env-file=.env scripts/run-billing-jobs.ts all",
    "knowledge:ingest": "tsx --env-file=.env scripts/ingest-knowledge-pdf.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@langchain/core": "^0.3.42",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/ollama": "^0.2.0",
    "@langchain/openai": "^0.4.9",
    "@supabase/supabase-js": "^2.49.1",
    "fastify": "^5.2.1",
    "joi": "^17.13.3",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.4",
    "prettier": "^3.5.3",
    "supabase": "^2.104.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
